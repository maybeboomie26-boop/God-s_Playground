<script>
const c=document.getElementById("c"),x=c.getContext("2d");
let w,h,t=0;
function resize(){w=c.width=innerWidth;h=c.height=innerHeight}
resize();
addEventListener("resize",resize);
let p=[];
for(let i=0;i<90;i++)p.push({
x:Math.random()*innerWidth,
y:Math.random()*innerHeight,
vx:(Math.random()-.5)*.4,
vy:(Math.random()-.5)*.4,
r:Math.random()*1.8+.2,
a:Math.random()*.5+.05
});
function draw(){
t+=.002;
x.clearRect(0,0,w,h);
for(let i=0;i<p.length;i++){
let a=p[i];
a.x+=a.vx;
a.y+=a.vy;
if(a.x<0||a.x>w)a.vx*=-1;
if(a.y<0||a.y>h)a.vy*=-1;
for(let j=i+1;j<p.length;j++){
let b=p[j],dx=a.x-b.x,dy=a.y-b.y,d=Math.sqrt(dx*dx+dy*dy);
if(d<150){
x.beginPath();
x.moveTo(a.x,a.y);
x.lineTo(b.x,b.y);
x.strokeStyle="rgba(70,110,255,"+(0.12*(1-d/150))+")";
x.stroke();
}
}
x.beginPath();
x.arc(a.x,a.y,a.r,0,Math.PI*2);
x.fillStyle="rgba(170,190,255,"+a.a+")";
x.fill();
}
for(let i=0;i<7;i++){
let ang=t*(i%2?-1:1)*(0.15+i*.04)+i*1.8;
let cx=w*(.15+Math.sin(i*4.7)*.1),cy=h*(.2+Math.cos(i*3.1)*.25);
let len=180+i*90;
x.beginPath();
x.moveTo(cx,cy);
x.lineTo(cx+Math.cos(ang)*len,cy+Math.sin(ang)*len);
x.strokeStyle="rgba("+((i%3)*90)+","+(120+i*10)+",255,.08)";
x.stroke();
}
requestAnimationFrame(draw);
}
draw();
</script>
